#include <ESP32Servo.h>

Servo myServo;

void setup() {
  myServo.attach(26);  // Connect servo to pin 26
}

void loop() {
  // Sweep from 0 to 180 degrees
  for (int angle = 0; angle <= 120; angle++) {
    myServo.write(angle);
    delay(15);
  }
  
  // Sweep back from 180 to 0 degrees
  for (int angle = 120; angle >= 0; angle--) {
    myServo.write(angle);
    delay(15);
  }
}
